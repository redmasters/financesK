# Variáveis usadas por docker-compose-prod.yml
# Copie para .env e preencha com os valores reais. O arquivo .env não é versionado.

# Banco de dados PostgreSQL (acessível pela rede Tailscale).
# DB_HOST = IP Tailscale do servidor do BANCO (ex.: 100.x.y.z), NÃO o IP desta máquina.
DB_HOST=
DB_PORT=5432
DB_NAME=financesk_db
DB_USER=financesk_admin
DB_PASSWORD=

# URL pública da aplicação
APP_BASE_URL=

# SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# JWT
SECRET_KEY=
